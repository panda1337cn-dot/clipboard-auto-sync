def clipboard_image_to_base64():
    img = ImageGrab.grabclipboard()

    if isinstance(img, Image.Image):
        buffered = io.BytesIO()
        img.save(buffered, format="PNG")
        img_str = base64.b64encode(buffered.getvalue()).decode('utf-8')
      
        base64_formatted = f"data:image/jpeg;base64,{img_str}"
        
        return base64_formatted
    else:
        return 0



def copy_base64_to_clipboard(base64_str):
    # 1. 解码Base64
    if "base64," in base64_str:
        base64_str = base64_str.split(",")[1]
    img_data = base64.b64decode(base64_str)
    
    # 2. 将数据转为位图格式 (BMP)
    image = Image.open(io.BytesIO(img_data))
    output = io.BytesIO()
    # 必须转换为BMP格式才能被Windows剪贴板兼容
    image.convert("RGB").save(output, "BMP")
    data = output.getvalue()[14:] # 去除BMP文件头
    output.close()
    
    # 3. 写入Windows剪贴板
    win32clipboard.OpenClipboard()
    win32clipboard.EmptyClipboard()
    # 使用 CF_DIB (Device Independent Bitmap)
    win32clipboard.SetClipboardData(win32clipboard.CF_DIB, data)
    win32clipboard.CloseClipboard()


